{
  "Urls": "http://127.0.0.1:7180",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "taller": {
        "ClusterId": "web",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "web": {
        "Destinations": {
          "local": {
            "Address": "http://127.0.0.1:7181/"
          }
        }
      }
    }
  }
}
