@model RepairOrder
@{ViewData["Title"]="Nueva orden";}
<div class="page-head"><div><div class="eyebrow">REPARACIONES</div><h1>Nueva orden</h1><p>Registra el problema y comienza el seguimiento.</p></div><a asp-action="Index">Volver →</a></div>
<section class="panel form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="field"><label asp-for="EquipmentId"></label><select class="form-select" asp-for="EquipmentId" asp-items="ViewBag.Equipment"><option value="">Seleccione un equipo</option></select><small>¿Todavía no está registrado? <a asp-controller="Equipment" asp-action="Edit">Añadir equipo</a> · <a asp-controller="Customers" asp-action="Edit">Añadir cliente</a></small></div><div class="form-grid"><div class="field"><label asp-for="ServiceMode"></label><select asp-for="ServiceMode" class="form-select"><option value="Taller">Reparación en el taller</option><option value="Domicilio">Servicio a domicilio</option></select></div><div class="field"><label asp-for="ServiceAddress"></label><input asp-for="ServiceAddress" class="form-control" maxlength="300"/><small>Obligatoria cuando el arreglo es a domicilio.</small></div></div><div class="field"><label asp-for="ReportedFault"></label><textarea class="form-control" asp-for="ReportedFault" rows="4" required maxlength="1500"></textarea></div><div class="field"><label asp-for="DueDate"></label><input class="form-control" asp-for="DueDate" type="date" /></div><div class="form-actions"><button class="btn btn-primary">Crear orden de reparación</button><a class="btn btn-soft" asp-action="Index">Cancelar</a></div></form></section>
