@model RepairOrder
@{ViewData["Title"]=Model.Number;var closed=Model.Status is RepairStatus.Entregado or RepairStatus.Cancelado;var version=Convert.ToBase64String(Model.RowVersion);}
<div class="page-head"><div><div class="eyebrow">ORDEN DE REPARACIÓN</div><h1>@Model.Number <partial name="_Estado" model="Model.Status" /></h1><p>Recibido el @Labels.Local(Model.ReceivedAt).ToString("dd/MM/yyyy HH:mm")</p></div><a class="btn btn-soft" asp-action="Print" asp-route-id="@Model.Id" target="_blank">Imprimir comprobante</a></div>
<div class="stats"><div class="stat"><span>Presupuesto total</span><strong>@Labels.Money(Model.Total)</strong><small>@(Model.BudgetApproved?"Aprobado por el cliente":"Pendiente de aprobación")</small></div><div class="stat"><span>Pagos recibidos</span><strong>@Labels.Money(Model.Paid)</strong><small>@Model.Payments.Count pagos</small></div><div class="stat"><span>Saldo pendiente</span><strong>@Labels.Money(Model.Balance)</strong><small>Por cobrar</small></div><div class="stat"><span>Fecha estimada</span><strong class="date-stat">@(Model.DueDate?.ToString("dd/MM/yyyy")??"Por definir")</strong><small>@(Model.Employee?.Name??"Sin empleado asignado")</small></div></div>
<div class="detail-grid"><div><section class="panel"><h2>Cliente y equipo</h2><div class="info-grid"><div><strong>@Model.Equipment!.Customer!.Name</strong><p>@Model.Equipment.Customer.Phone<br/>@Model.Equipment.Customer.Address</p></div><div><strong>@Model.Equipment.Type · @Model.Equipment.Brand</strong><p>Modelo: @(Model.Equipment.Model??"—")<br/>Serie: @(Model.Equipment.Serial??"—")</p></div></div><div class="fault"><label>@(Model.ServiceMode==ServiceMode.Domicilio?"Servicio a domicilio":"Reparación en el taller")</label>@if(Model.ServiceMode==ServiceMode.Domicilio){<p>@Model.ServiceAddress</p>}<label>Falla reportada</label><p>@Model.ReportedFault</p><small>Condición / accesorios: @(Model.Equipment.Accessories??"Sin observaciones")</small></div></section>
<section class="panel"><h2>Diagnóstico y presupuesto</h2><form asp-action="Update" asp-route-id="@Model.Id" method="post"><input type="hidden" name="rowVersion" value="@version"/><fieldset disabled="@closed"><div class="field"><label for="diagnosis">Diagnóstico</label><textarea id="diagnosis" name="diagnosis" class="form-control" rows="3" maxlength="2000">@Model.Diagnosis</textarea></div><div class="form-grid"><div class="field"><label for="employeeId">Empleado asignado</label><select id="employeeId" name="employeeId" class="form-select" asp-items="ViewBag.Employees"><option value="">Sin asignar</option></select></div><div class="field"><label for="labor">Mano de obra (Bs)</label><input id="labor" type="number" step="0.01" min="0" max="99999999" name="labor" class="form-control" value="@Model.Labor.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" required/></div><div class="field"><label for="dueDate">Fecha estimada</label><input id="dueDate" type="date" name="dueDate" class="form-control" value="@Model.DueDate?.ToString("yyyy-MM-dd")"/></div></div><div class="field"><label for="notes">Notas del trabajo</label><textarea id="notes" name="notes" rows="2" class="form-control" maxlength="2000">@Model.Notes</textarea></div><label class="check-label"><input type="checkbox" name="approved" value="true" checked="@Model.BudgetApproved"/> El cliente aprobó este presupuesto</label><div class="form-actions"><button class="btn btn-primary">Guardar diagnóstico y presupuesto</button></div></fieldset></form></section>
<section class="panel"><h2>Repuestos utilizados</h2>@if(Model.Parts.Any()){<table class="table"><thead><tr><th>Repuesto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>@foreach(var p in Model.Parts){<tr><td data-label="Repuesto">@p.Part!.Name</td><td data-label="Cantidad">@p.Quantity</td><td data-label="Precio">@Labels.Money(p.UnitPrice)</td><td data-label="Subtotal">@Labels.Money(p.Quantity*p.UnitPrice)</td></tr>}</tbody></table>}else{<p class="muted">No hay repuestos asociados a esta orden.</p>}
@if(!closed){<form class="inline-form" asp-action="AddPart" asp-route-id="@Model.Id" method="post"><label class="visually-hidden" for="partId">Pieza o repuesto</label><select id="partId" name="partId" class="form-select" asp-items="ViewBag.Parts" required><option value="">Seleccionar repuesto</option></select><label class="visually-hidden" for="quantity">Cantidad de piezas</label><input id="quantity" type="number" class="form-control quantity" name="quantity" value="1" min="1" max="1000000" required/><button class="btn btn-soft">Añadir</button></form><small>Descuenta existencias y deja el presupuesto pendiente de aprobación.</small>}</section>
<section class="panel"><h2>Pagos</h2>@if(Model.Payments.Any()){<table class="table"><thead><tr><th>Fecha</th><th>Método / referencia</th><th>Importe</th></tr></thead><tbody>@foreach(var p in Model.Payments.OrderByDescending(x=>x.PaidAt)){<tr><td data-label="Fecha">@Labels.Local(p.PaidAt).ToString("dd/MM/yyyy HH:mm")</td><td data-label="Método / referencia">@p.Method<small>@p.Reference</small></td><td data-label="Importe">@Labels.Money(p.Amount)</td></tr>}</tbody></table>}else{<p class="muted">No hay pagos registrados.</p>}
@if(!closed){<form asp-action="Pay" asp-route-id="@Model.Id" method="post"><div class="form-grid"><div class="field"><label for="amount">Importe (Bs)</label><input id="amount" type="number" name="amount" class="form-control" step="0.01" min="0.01" required/></div><div class="field"><label for="method">Método</label><select id="method" name="method" class="form-select"><option>Efectivo</option><option>Transferencia</option><option>QR</option><option>Tarjeta</option></select></div><div class="field"><label for="reference">Referencia</label><input id="reference" name="reference" class="form-control" maxlength="100"/></div></div><button class="btn btn-primary">Registrar pago</button></form>}</section></div>
<aside><section class="panel"><h2>Estado del trabajo</h2>@if(!closed){<form asp-action="Status" asp-route-id="@Model.Id" method="post"><input type="hidden" name="rowVersion" value="@version"/><label class="visually-hidden" for="status">Nuevo estado</label><select id="status" name="status" class="form-select mb-3">@foreach(var s in Enum.GetValues<RepairStatus>().Where(x=>x!=Model.Status)){<option value="@s">@Labels.Status(s)</option>}</select><button class="btn btn-primary w-100">Actualizar estado</button></form><small class="mt-3 d-block">La entrega requiere reparación terminada y saldo pagado.</small>}else{<p>Orden cerrada. El historial se conserva.</p>}
</section><section class="panel timeline"><h2>Historial</h2>@foreach(var e in Model.Events.OrderByDescending(x=>x.CreatedAt)){<div class="timeline-item"><small>@Labels.Local(e.CreatedAt).ToString("dd/MM/yyyy HH:mm")</small><p>@e.Description</p></div>}</section></aside></div>
