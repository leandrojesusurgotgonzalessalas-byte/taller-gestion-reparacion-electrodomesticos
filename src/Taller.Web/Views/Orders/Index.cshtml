@model List<RepairOrder>
@{ViewData["Title"]="Reparaciones";}
<div class="page-head"><div><div class="eyebrow">SEGUIMIENTO</div><h1>Reparaciones</h1><p>Cada equipo, desde la recepción hasta la entrega.</p></div><a class="btn btn-primary btn-cta" asp-action="Create">+ Nueva orden</a></div>
<section class="panel"><form class="searchbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Orden, cliente, marca o falla…"/><select name="status" class="form-select"><option value="">Todos los estados</option>@foreach(var s in Enum.GetValues<RepairStatus>()){<option value="@s" selected="@(ViewBag.Status!=null && (RepairStatus)ViewBag.Status==s)">@Labels.Status(s)</option>}</select><button class="btn btn-soft">Buscar</button><a asp-action="Index">Limpiar</a></form>
@if(!Model.Any()){<div class="empty"><h3>No hay órdenes para mostrar</h3><p>Recibe un equipo para empezar o modifica los filtros.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Orden</th><th>Cliente / equipo</th><th>Estado</th><th>Fecha estimada</th><th>Total</th><th>Saldo</th></tr></thead><tbody>@foreach(var o in Model){<tr><td data-label="Orden"><a class="strong" asp-action="Details" asp-route-id="@o.Id">@o.Number</a><small>@Labels.Local(o.ReceivedAt).ToString("dd/MM/yyyy")</small></td><td data-label="Cliente / equipo">@o.Equipment!.Customer!.Name<small>@o.Equipment.Type · @o.Equipment.Brand @o.Equipment.Model · @o.ServiceMode</small></td><td data-label="Estado"><partial name="_Estado" model="o.Status" /></td><td data-label="Fecha estimada">@o.DueDate?.ToString("dd/MM/yyyy")</td><td data-label="Total">@Labels.Money(o.Total)</td><td data-label="Saldo">@Labels.Money(o.Balance)</td></tr>}</tbody></table></div>}</section>
