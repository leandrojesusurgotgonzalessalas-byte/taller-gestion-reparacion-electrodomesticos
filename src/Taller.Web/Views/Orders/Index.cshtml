@model List<RepairOrder>
@{ViewData["Title"]="Reparaciones";}
<div class="page-head"><div><div class="eyebrow">SEGUIMIENTO</div><h1>Reparaciones</h1><p>Cada equipo, desde la recepción hasta la entrega.</p></div><a class="btn btn-primary btn-cta" asp-action="Create">+ Nueva orden</a></div>
<section class="panel">
    <form class="searchbar" method="get">
        <input class="form-control" name="q" value="@ViewBag.Query" placeholder="Orden, cliente, marca o falla…"/>
        <select name="status" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var status in Enum.GetValues<RepairStatus>())
            {
                <option value="@status" selected="@(ViewBag.Status is RepairStatus current && current == status)">@Labels.Status(status)</option>
            }
        </select>
        <button class="btn btn-soft">Buscar</button><a asp-action="Index">Limpiar</a>
    </form>
    @if (Model.Count == 0)
    {
        <div class="empty"><h3>No hay órdenes para mostrar</h3><p>Recibe un equipo para empezar o modifica los filtros.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Orden</th><th>Cliente / equipo</th><th>Estado</th><th>Fecha estimada</th><th>Total</th><th>Saldo</th><th>Acciones</th></tr></thead>
                <tbody>
                @foreach (var o in Model)
                {
                    var closed = o.Status is RepairStatus.Entregado or RepairStatus.Cancelado;
                    var paid = o.Paid > 0 && o.Balance == 0;
                    var canCancel = !closed && o.Status != RepairStatus.Reparado && o.Paid == 0;
                    <tr>
                        <td data-label="Orden"><a class="strong" asp-action="Details" asp-route-id="@o.Id">@o.Number</a><small>@Labels.Local(o.ReceivedAt).ToString("dd/MM/yyyy")</small></td>
                        <td data-label="Cliente / equipo">@o.Equipment!.Customer!.Name<small>@o.Equipment.Type · @o.Equipment.Brand @o.Equipment.Model · @o.ServiceMode</small></td>
                        <td data-label="Estado"><a class="detail-badge" asp-action="Details" asp-route-id="@o.Id" aria-label="@Labels.Status(o.Status): ver detalles de @o.Number"><partial name="_Estado" model="o.Status" /></a></td>
                        <td data-label="Fecha estimada">@o.DueDate?.ToString("dd/MM/yyyy")</td>
                        <td data-label="Total">@Labels.Money(o.Total)</td>
                        <td data-label="Saldo">@Labels.Money(o.Balance)</td>
                        <td data-label="Acciones">
                            <div class="d-flex flex-wrap gap-2">
                                @if (paid)
                                {
                                    <a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@o.Id" asp-fragment="pagos" aria-label="Pagado: ver cobros de @o.Number">✓ Pagado</a>
                                }
                                else if (!closed && o.Balance > 0)
                                {
                                    <a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@o.Id" asp-fragment="pagos" aria-label="Registrar pago de @o.Number">Registrar pago</a>
                                }
                                @if (canCancel)
                                {
                                    <form asp-action="Status" asp-route-id="@o.Id" method="post" data-confirmar-cancelacion="@o.Number">
                                        <input type="hidden" name="status" value="Cancelado"/>
                                        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(o.RowVersion)"/>
                                        <button type="submit" class="btn btn-soft btn-sm" aria-label="Cancelar orden @o.Number">Cancelar</button>
                                    </form>
                                }
                                else if (o.Status == RepairStatus.Cancelado)
                                {
                                    <span class="btn btn-soft btn-sm disabled">Cancelado</span>
                                }
                                <a class="btn btn-soft btn-sm" asp-action="Details" asp-route-id="@o.Id" asp-fragment="@(closed ? null : "editar-orden")" aria-label="@(closed ? "Ver orden" : "Editar orden") @o.Number">@(closed ? "Ver orden" : "Editar")</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
