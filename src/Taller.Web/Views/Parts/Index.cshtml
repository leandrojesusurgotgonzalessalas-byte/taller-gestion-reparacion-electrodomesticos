@model List<Part>
@{ViewData["Title"]="Repuestos";}
<div class="page-head"><div><div class="eyebrow">GESTIÓN</div><h1>Repuestos</h1><p>Consulta y administra los repuestos del taller.</p></div><a class="btn btn-primary btn-cta" asp-action="Edit">+ Nuevo repuesto</a></div>
<section class="panel"><form class="searchbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Buscar repuestos…"/><button class="btn btn-soft">Buscar</button><a asp-action="Index">Limpiar</a></form>
@if(!Model.Any()){<div class="empty"><h3>No hay repuestos para mostrar</h3><p>Registra un repuesto o cambia la búsqueda.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Código</th><th>Repuesto</th><th>Existencias</th><th>Precio</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td data-label="Código">@x.Code</td><td data-label="Repuesto" class="strong">@x.Name</td><td data-label="Existencias"><span class="@(x.Stock<=2?"stock-low":"")">@x.Stock</span></td><td data-label="Precio">@Labels.Money(x.Price)</td><td data-label="Acciones"><a asp-action="Edit" asp-route-id="@x.Id">Editar →</a></td></tr>}</tbody></table></div>}</section>
