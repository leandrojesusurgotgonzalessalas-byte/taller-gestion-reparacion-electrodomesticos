@model Part
@{ViewData["Title"]=Model.Id==0?"Nuevo repuesto":"Editar repuesto";}
<div class="page-head"><div><div class="eyebrow">PIEZAS / REPUESTOS</div><h1>@ViewData["Title"]</h1></div><a asp-action="Index">Volver →</a></div>
<section class="panel form-panel"><form method="post" asp-action="Edit" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)"><div asp-validation-summary="All" class="text-danger"></div>
<input type="hidden" asp-for="RowVersion" />
<div class="form-grid"><div class="field"><label asp-for="SupplierId"></label><select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select"><option value="">Sin proveedor asignado</option></select></div><div class="field"><label asp-for="Code"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
<partial name="_CatalogoElectrodomesticos" model='@("piezas")' />
<div class="field"><label asp-for="Name"></label><input asp-for="Name" class="form-control" list="piezasElectrodomesticos" placeholder="Selecciona o escribe la pieza para venta o reparación" autocomplete="off" aria-describedby="ayudaCompatibilidadPieza" /><small id="ayudaCompatibilidadPieza">Sugerencias generales de piezas para venta o reparación. Verifica marca, modelo y compatibilidad de la pieza.</small><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="field"><label asp-for="Stock"></label><input asp-for="Stock" class="form-control" /><span asp-validation-for="Stock" class="text-danger"></span></div>
<div class="field"><label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span></div>
</div><div class="form-actions"><button class="btn btn-primary">Guardar repuesto</button><a class="btn btn-soft" asp-action="Index">Cancelar</a></div></form></section>
