@model List<Equipment>
@{ViewData["Title"]="Equipos";}
<div class="page-head"><div><div class="eyebrow">GESTIÓN</div><h1>Equipos</h1><p>Consulta y administra los equipos del taller.</p></div><a class="btn btn-primary btn-cta" asp-action="Edit">+ Nuevo equipo</a></div>
<section class="panel"><form class="searchbar" method="get"><input class="form-control" name="q" value="@ViewBag.Query" placeholder="Buscar equipos…"/><button class="btn btn-soft">Buscar</button><a asp-action="Index">Limpiar</a></form>
@if(!Model.Any()){<div class="empty"><h3>No hay equipos para mostrar</h3><p>Registra un equipo o cambia la búsqueda.</p></div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Electrodoméstico</th><th>Cliente</th><th>Serie</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td data-label="Electrodoméstico" class="strong">@x.Type<small>@x.Brand @x.Model</small></td><td data-label="Cliente">@x.Customer!.Name</td><td data-label="Serie">@x.Serial</td><td data-label="Acciones"><a asp-controller="Orders" asp-action="Create" asp-route-equipmentId="@x.Id">Recibir</a> · <a asp-action="Edit" asp-route-id="@x.Id">Editar</a></td></tr>}</tbody></table></div>}</section>
